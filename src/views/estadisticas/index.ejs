
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Estadísticas - Gestor de gastos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2">Estadísticas de gastos</h1>
            <a href="/" class="btn btn-outline-secondary">Volver al inicio</a>
        </div>

        <!-- Gastos por categoría -->
        <section class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h2 class="h5 mb-0">Gastos por categoría</h2>
            </div>

            <div class="card-body">
                <% if (gastosPorCategoria.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Categoría</th>
                                    <th>Total gastado</th>
                                    <th>Cantidad de gastos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% gastosPorCategoria.forEach(gasto => { %>
                                    <tr>
                                        <td><%= gasto.categoria %></td>
                                        <td>$ <%= gasto.total.toLocaleString('es-AR') %></td>
                                        <td><%= gasto.cantidad %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="text-muted mb-0">Todavía no hay gastos registrados.</p>
                <% } %>
            </div>
        </section>

        <!-- Gastos por mes -->
        <section class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h2 class="h5 mb-0">Gastos por mes</h2>
            </div>

            <div class="card-body">
                <% if (gastosPorMes.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Año</th>
                                    <th>Mes</th>
                                    <th>Total gastado</th>
                                    <th>Cantidad de gastos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% gastosPorMes.forEach(gasto => { %>
                                    <tr>
                                        <td><%= gasto.anio %></td>
                                        <td><%= new Date(gasto.anio, gasto.mes - 1).toLocaleString('es-AR', { month: 'long' }) %></td>
                                        <td>$ <%= gasto.total.toLocaleString('es-AR') %></td>
                                        <td><%= gasto.cantidad %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="text-muted mb-0">Todavía no hay gastos registrados.</p>
                <% } %>
            </div>
        </section>

        <!-- Gastos por método de pago -->
        <section class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
                <h2 class="h5 mb-0">Gastos por método de pago</h2>
            </div>

            <div class="card-body">
                <% if (gastosPorMetodo.length > 0) { %>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Método de pago</th>
                                    <th>Total gastado</th>
                                    <th>Cantidad de gastos</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% gastosPorMetodo.forEach(gasto => { %>
                                    <tr>
                                        <td><%= gasto.metodoPago %></td>
                                        <td>$ <%= gasto.total.toLocaleString('es-AR') %></td>
                                        <td><%= gasto.cantidad %></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <p class="text-muted mb-0">Todavía no hay gastos registrados.</p>
                <% } %>
            </div>
        </section>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
