
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestionar gastos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="container py-5">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2">Gestionar gastos</h1>

            <div>
                <a href="/gastos/crear" class="btn btn-primary">Nuevo gasto</a>
                <a href="/" class="btn btn-outline-secondary">Volver</a>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">

                <% if (gastos.length > 0) { %>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle">

                            <thead class="table-dark">
                                <tr>
                                    <th>Descripción</th>
                                    <th>Categoría</th>
                                    <th>Monto</th>
                                    <th>Fecha</th>
                                    <th>Método de pago</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                <% gastos.forEach(gasto => { %>
                                    <tr>
                                        <td><%= gasto.descripcion %></td>

                                        <td>
                                            <%= gasto.categoriaId ? gasto.categoriaId.nombre : 'Sin categoría' %>
                                        </td>

                                        <td>
                                            $ <%= gasto.monto.toLocaleString('es-AR') %>
                                        </td>

                                        <td>
                                            <%= new Date(gasto.fecha).toLocaleDateString('es-AR') %>
                                        </td>

                                        <td><%= gasto.metodoPago %></td>

                                        <td>
                                            <form
                                                action="/gastos/<%= gasto._id %>?_method=DELETE"
                                                method="POST"
                                                onsubmit="return confirm('¿Estás seguro de que querés eliminar este gasto?')"
                                            >
                                                <button type="submit" class="btn btn-danger btn-sm">
                                                    Eliminar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>

                        </table>
                    </div>

                <% } else { %>

                    <div class="alert alert-info mb-0">
                        Todavía no tenés gastos registrados.
                    </div>

                <% } %>

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
