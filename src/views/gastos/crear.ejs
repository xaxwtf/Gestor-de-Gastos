
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar gasto | Gestor de gastos</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/gastos.css">
</head>

<body class="bg-light">

    <div class="container py-5">

        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-6">

                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">

                        <h1 class="text-center mb-2">Registrar gasto</h1>
                        <p class="text-center text-muted mb-4">
                            Completá los datos del movimiento
                        </p>

                        <form action="/gastos" method="POST">

                            <!-- Descripción -->
                            <div class="mb-3">
                                <label for="descripcion" class="form-label">
                                    Descripción
                                </label>

                                <input
                                    type="text"
                                    class="form-control"
                                    id="descripcion"
                                    name="descripcion"
                                    maxlength="100"
                                    placeholder="Ej: Compra de alimentos"
                                    required
                                >
                            </div>

                            <!-- Categoría -->
                            <div class="mb-3">
                                <label for="categoria" class="form-label">
                                    Categoría
                                </label>
                            <input
                                type="text"
                                name="categoria"
                                id="categoria"
                                class="form-control"
                                list="categorias"
                                placeholder="Seleccioná o escribí una categoría"
                                maxlength="50"
                                required
                            >

                            <datalist id="categorias">
                                <% categorias.forEach(categoria => { %>
                                    <option value="<%= categoria.nombre %>">
                                <% }) %>
                            </datalist>


                            </div>

                            <!-- Monto -->
                            <div class="mb-3">
                                <label for="monto" class="form-label">
                                    Monto ($)
                                </label>

                                <input
                                    type="number"
                                    class="form-control"
                                    id="monto"
                                    name="monto"
                                    min="0.01"
                                    step="0.01"
                                    placeholder="Ej: 15000"
                                    required
                                >
                            </div>

                            <!-- Fecha -->
                            <div class="mb-3">
                                <label for="fecha" class="form-label">
                                    Fecha
                                </label>

                                <input
                                    type="date"
                                    class="form-control"
                                    id="fecha"
                                    name="fecha"
                                    required
                                >
                            </div>

                            <!-- Método de pago -->
                            <div class="mb-4">
                                <label for="metodoPago" class="form-label">
                                    Método de pago
                                </label>

                                <select
                                    class="form-select"
                                    id="metodoPago"
                                    name="metodoPago"
                                >
                                    <option value="Efectivo">Efectivo</option>
                                    <option value="Débito">Débito</option>
                                    <option value="Crédito">Crédito</option>
                                    <option value="Transferencia">Transferencia</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>

                            <!-- Botones -->
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary w-100">
                                    Guardar gasto
                                </button>

                                <a href="/" class="btn btn-outline-secondary w-100">
                                    Cancelar
                                </a>
                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
