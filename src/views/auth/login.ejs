
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar sesión</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Estilos propios -->
    <link rel="stylesheet" href="/css/login.css">

        <div class="botones-prueba">
            <button type="button" onclick="completarUsuario1()">
                Usuario de prueba 1
            </button>

            <button type="button" onclick="completarUsuario2()">
                Usuario de prueba 2
            </button>
        </div>

        <script>
            function completarUsuario1() {
                document.getElementById('email').value = 'xaxwtf@gmail.com';
                document.getElementById('password').value = 'test123456789';
            }

            function completarUsuario2() {
                document.getElementById('email').value = 'test1@test.com';
                document.getElementById('password').value = 'test123456789';
            }
        </script>

</head>
<body>

    <div class="container d-flex justify-content-center align-items-center min-vh-100">

        <div class="card shadow-sm login-card">

            <h3 class="text-center mb-4">Gestor de gastos</h3>

            <form action="/auth/login" method="POST">

                <div class="mb-3">
                    <label for="email" class="form-label">
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        class="form-control"
                        id="email"
                        name="email"
                        placeholder="ejemplo@correo.com"
                        required
                    >
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">
                        Contraseña
                    </label>

                    <input
                        type="password"
                        class="form-control"
                        id="password"
                        name="password"
                        placeholder="Ingresá tu contraseña"
                        required
                    >
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                <% } %>

                <button type="submit" class="btn btn-primary w-100">
                    Iniciar sesión
                </button>
                <p class="text-center mt-3">
                    ¿No tenés una cuenta?
                    <a href="/auth/registro">Registrate aquí</a>
                </p>
            </form>

        </div>

    </div>

</body>
</html>
